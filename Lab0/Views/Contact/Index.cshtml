@model List<Contact>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2>Kontakty</h2>
<a class="btn btn-outline-primary" asp-controller="Contact" asp-action="Create">Dodaj kontakt</a>
<h3>Lista</h3>
<ul>
    @{
        foreach (var obj in Model)
        {
            <li>@obj.Name</li>
        }
    }
</ul>
